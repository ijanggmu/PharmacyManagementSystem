# ──────────────────────────────────────────────────────────────────────
# Pharmacy Management System — production docker-compose configuration.
# Copy to `.env` and edit. NEVER commit .env to git.
# Compose refuses to start until every required (?-flagged) var is set.
# ──────────────────────────────────────────────────────────────────────

# ── Images ───────────────────────────────────────────────────────
# Set by the deploy workflow; leave as-is to build locally with --build.
# CI images: IMAGE_PREFIX=ghcr.io/<github-owner>/pharmacy, IMAGE_TAG=<commit sha>
IMAGE_PREFIX=fsh
IMAGE_TAG=local

# Optional profiles, comma-separated: `admin` runs the operator console,
# `caddy` the bundled TLS edge (skip if the host already runs a proxy).
# COMPOSE_PROFILES=admin,caddy

# Host already runs nginx-proxy + acme-companion? Add the overlay instead of caddy:
# COMPOSE_FILE=docker-compose.yml:docker-compose.nginx-proxy.yml
# PROXY_NETWORK=nginx-proxy-network-name
# LETSENCRYPT_EMAIL=you@example.com

# ── Public URLs ──────────────────────────────────────────────────────
# Where each surface is reachable from end users' browsers (via your
# external proxy / TLS terminator). Used by:
#   • admin console, baked into /config.json at container start
#   • pharmacy web app, baked into the Next.js bundle at build time
#   • API CORS allow-list for the two frontend origins
FSH_API_URL=https://api.example.com
FSH_ADMIN_URL=https://admin.example.com
PHARMACY_APP_URL=https://app.example.com

# Bare hostnames for the Caddy profile / nginx-proxy overlay.
PHARMACY_APP_HOST=app.example.com
FSH_ADMIN_HOST=admin.example.com
FSH_API_HOST=api.example.com

# API host filtering (AllowedHosts). Defaults to "$FSH_API_HOST;fsh-api;api;localhost;127.0.0.1";
# override only if the API is reached under additional public hostnames (semicolon-separated).
# API_ALLOWED_HOSTS=

# Optional: per-tenant subdomains (acme.app.example.com → tenant "acme").
PHARMACY_TENANT_ROOT_DOMAIN=

# Optional pharmacy web app settings (baked in at build time — rebuild after changing).
# GOOGLE_CLIENT_ID must also be listed in the API's GoogleAuth:ClientIds.
GOOGLE_CLIENT_ID=
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Default tenant identifier used by the login forms on first paint.
FSH_DEFAULT_TENANT=root

# ── Host ports for the external proxy to point at ───────────────────
# Only FSH services publish ports. Postgres/Redis/RustFS stay
# compose-internal by default (uncomment their `ports:` blocks in
# docker-compose.yml if you need host access for psql / redis-cli).
FSH_API_PORT=8080
FSH_ADMIN_PORT=8081
PHARMACY_APP_PORT=3000

# ── Secrets ─────────────────────────────────────────────────────────
# JWT signing key — must be 32+ chars and NOT contain the substring
# "replace-with" (the framework's placeholder detector blocks that).
# Generate with:    openssl rand -base64 48
JWT_SIGNING_KEY=

# Initial root admin password the seeder uses on first boot. Sign in
# at https://admin.example.com with admin@root.com using this value,
# then rotate from Settings → Security immediately. Required.
SEED_ADMIN_PASSWORD=

# Hangfire dashboard credentials — MUST be set. UserName min 3 chars,
# Password min 12 chars (enforced at startup).
# Access the dashboard at <FSH_API_URL>/jobs after login.
HANGFIRE_USERNAME=
HANGFIRE_PASSWORD=

# ── Data plane (defaults are fine for self-hosted compose) ──────────
POSTGRES_PASSWORD=
# Also used by the web app's session store (REDIS_URL in docker-compose.yml):
# keep it URL-safe (letters and digits only).
REDIS_PASSWORD=
# RustFS (S3 object storage) credentials; the API uses the same pair.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Observability (optional) ────────────────────────────────────────
# Ship API logs + traces over OTLP. Leave blank to disable export.
# Collector (gRPC): http://otel-collector:4317
# Seq on a shared network: http://seq:5341/ingest/otlp with
#   OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf and OTEL_METRICS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_METRICS_ENABLED=true

# ── Web app (BFF) ────────────────────────────────────────────────────
# Number of reverse proxies in front of the web container that append to
# X-Forwarded-For (nginx / nginx-proxy / Caddy = 1).
TRUSTED_PROXY_HOPS=1

# Optional: server-side error tracking for the web app. Any Sentry-compatible
# DSN (Sentry, GlitchTip, Bugsink…): https://<public key>@<host>/<project id>.
# Leave empty to disable (the default). Runtime setting — no rebuild needed.
# Only the error, request method + path and route tags are sent (no query
# strings, headers, cookies or bodies). The release is the deployed image sha.
WEB_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# ── Deploys (scripts/deploy.sh, run by the GitHub deploy workflow) ──────────
# Every key is optional; the defaults are shown. Before each rollout the
# database is dumped to DEPLOY_BACKUP_DIR (newest DEPLOY_BACKUP_KEEP kept) and a
# failed dump aborts the deploy. After `docker compose up` the API health
# endpoint and the web app are polled for up to DEPLOY_HEALTH_TIMEOUT seconds;
# if they don't come up, the previous release is started again and the job fails.
# DEPLOY_HEALTH_TIMEOUT=300
# DEPLOY_BACKUP_KEEP=5
# DEPLOY_BACKUP_DIR=/opt/pharmacy/backups
# 0 skips the pre-deploy dump (not recommended):
# DEPLOY_BACKUP=1

# ── Off-site backup copy (scripts/backup.sh — nightly cron and pre-deploy) ──
# A dump on the same disk is not a backup. Set ONE of the two targets below;
# each is skipped while empty. Off-site copies are never pruned by the script:
# configure a lifecycle/retention rule on the bucket instead.
#
# a) rclone (install rclone on the host and `rclone config` a remote first):
# OFFSITE_RCLONE_REMOTE=b2:pharmacy-backups/db
# OFFSITE_RCLONE_CONFIG=/home/deploy/.config/rclone/rclone.conf
#
# b) any S3-compatible store (AWS S3, Backblaze B2, Cloudflare R2, Wasabi…),
#    uploaded with the amazon/aws-cli image — nothing to install on the host.
#    Use a key that can only write to this bucket.
# OFFSITE_S3_BUCKET=pharmacy-backups
# OFFSITE_S3_ACCESS_KEY=
# OFFSITE_S3_SECRET_KEY=
# Endpoint: omit for AWS.
# OFFSITE_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# OFFSITE_S3_REGION=us-east-1
# OFFSITE_S3_PREFIX=pharmacy/db
#
# Make a failed off-site copy fail the backup (default: warn only):
# OFFSITE_REQUIRED=1
